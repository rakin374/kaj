{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kaj",
  "scopeName": "source.kaj",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#type-declarations" },
    { "include": "#function-declarations" },
    { "include": "#imports" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#built-in-types" },
    { "include": "#type-identifiers" },
    { "include": "#function-calls" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kaj",
          "match": "//.*$"
        },
        {
          "name": "comment.block.kaj",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.kaj" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.kaj" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.kaj",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.kaj" }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.kaj" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.kaj",
          "match": "\\\\(?:[\\\"nrt])"
        },
        {
          "name": "invalid.illegal.escape.kaj",
          "match": "\\\\."
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "\\b(type|enum|newtype)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.kaj" },
            "2": { "name": "entity.name.type.kaj" }
          }
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.kaj" },
            "2": { "name": "entity.name.function.kaj" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.import.kaj" },
            "2": { "name": "entity.name.namespace.kaj" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.kaj",
          "match": "\\b(?:let|var|fn|type|enum|newtype)\\b"
        },
        {
          "name": "keyword.control.kaj",
          "match": "\\b(?:return|if|else|while|for|in|break|continue|match|import)\\b"
        },
        {
          "name": "keyword.operator.logical.kaj",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.kaj",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.none.kaj",
          "match": "\\bnone\\b"
        }
      ]
    },
    "built-in-types": {
      "name": "support.type.builtin.kaj",
      "match": "\\b(?:Bool|Int|Decimal|String|Bytes|None|List|Map|Optional|Result)\\b"
    },
    "type-identifiers": {
      "name": "entity.name.type.kaj",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "function-calls": {
      "name": "entity.name.function.call.kaj",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.kaj",
          "match": "(?<![A-Za-z0-9_.])(?:0|[1-9][0-9]*)\\.[0-9]+(?![A-Za-z0-9_.])"
        },
        {
          "name": "constant.numeric.integer.kaj",
          "match": "(?<![A-Za-z0-9_.])(?:0|[1-9][0-9]*)(?![A-Za-z0-9_.])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.kaj",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.kaj",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.kaj",
          "match": "\\*\\*=|\\+=|-=|\\*=|/=|%=|="
        },
        {
          "name": "keyword.operator.arithmetic.kaj",
          "match": "\\*\\*|[+\\-*/%]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.braces.kaj",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.kaj",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.kaj",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.kaj",
          "match": "[,.:]"
        }
      ]
    }
  }
}
