fn double(value: Int) -> Int {
    return value * 2
}

task Compute() -> Int {
    goal "Compute and report the answer"

    var value = 0

    invariant {
        value >= 0
    }

    step calculate {
        value = double(21)
    }

    step report {
        print(value)
    }

    success(result: Int) {
        result == 42
    }

    return value
}
